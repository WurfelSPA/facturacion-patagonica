{
  "functions": {
    "api/split-pdf.js": {
      "maxDuration": 300
    },
    "api/drive-pdf.js": {
      "maxDuration": 300
    },
    "api/historial-batch.js": {
      "maxDuration": 300
    },
    "api/historial.js": {
      "includeFiles": "historial-excel-2026.json",
      "maxDuration": 120
    },
    "api/planilla.js": {
      "maxDuration": 60
    },
    "api/aguas-andinas.js": {
      "maxDuration": 300
    },
    "api/aa-refresh.js": {
      "maxDuration": 300
    },
    "api/nubox-refresh.js": {
      "maxDuration": 300
    },
    "api/nubox-refresh-now.js": {
      "maxDuration": 300
    },
    "api/enel-refresh.js": {
      "maxDuration": 300
    },
    "api/nubox-pdf.js": {
      "maxDuration": 300
    },
    "api/storage.js": {
      "maxDuration": 60
    },
    "api/planilla-email.js": {
      "maxDuration": 120
    },
    "api/recordatorio-pago.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/aa-refresh",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/nubox-refresh",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/enel-refresh",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/planilla-email?recipients=preview",
      "schedule": "0 12 24 * *"
    },
    {
      "path": "/api/planilla-email?recipients=contabilidad",
      "schedule": "0 12 26 * *"
    },
    {
      "path": "/api/recordatorio-pago?trigger=dia20",
      "schedule": "0 13 20 * *"
    },
    {
      "path": "/api/recordatorio-pago?trigger=fin-mes",
      "schedule": "0 13 28-31 * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/aa-cache.json",
      "dest": "/aa-cache.json"
    },
    {
      "src": "/nubox-resumen-cache.json",
      "dest": "/nubox-resumen-cache.json"
    },
    {
      "src": "/enel-cache.json",
      "dest": "/enel-cache.json"
    },
    {
      "src": "/ajustes-contratos.json",
      "dest": "/ajustes-contratos.json"
    },
    {
      "src": "/clientes-seguimiento.json",
      "dest": "/clientes-seguimiento.json"
    },
    {
      "src": "/(.+\\.(png|jpg|jpeg|gif|svg|ico|webp|woff|woff2))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
