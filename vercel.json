{
  "functions": {
    "api/split-pdf.js": { "maxDuration": 300 },
    "api/drive-pdf.js": { "maxDuration": 300 },
    "api/historial-batch.js": { "maxDuration": 300 },
    "api/historial.js": { "includeFiles": "historial-excel-2026.json", "maxDuration": 120 },
    "api/planilla.js": { "maxDuration": 60 },
    "api/aguas-andinas.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/planilla?addMonth=1", "schedule": "0 12 25 * *" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.+\\.(png|jpg|jpeg|gif|svg|ico|webp|woff|woff2))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
