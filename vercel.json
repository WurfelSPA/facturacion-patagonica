{
  "functions": {
    "api/split-pdf.js": { "maxDuration": 60 },
    "api/drive-pdf.js": { "maxDuration": 60 },
    "api/historial-batch.js": { "maxDuration": 300 },
    "api/historial.js": { "includeFiles": "historial-excel-2026.json", "maxDuration": 120 },
    "api/agregar-mes.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/agregar-mes", "schedule": "0 12 25 * *" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
