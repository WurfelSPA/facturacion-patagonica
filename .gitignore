.vercel
.env*
node_modules/
render-service/node_modules/

# Archivos temporales de Excel (lock files)
.~lock.*#
~$*.xlsx
~$*.xls

# Archivos de datos generados (no deben versionarse)
historial-*.xlsx
historial-*.json
# Excepción: JSON embebido en bundle de Vercel para historial (requerido por includeFiles en vercel.json)
!historial-excel-2026.json
scripts/run-aa-local.bat

# Capturas de depuración del scraper AA (se generan en cada corrida local)
debug-*.png

# Sesión guardada de Aguas Andinas (cookies vivas — nunca versionar)
scripts/aa-session.json
scripts/aa-cookie-raw.txt

# graphify
graphify-out/
